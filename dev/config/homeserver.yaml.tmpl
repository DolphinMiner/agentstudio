# Synapse config for the AgentStudio local dev stack.
# Rendered by dev/stack.mjs into .local/synapse/homeserver.yaml. Dollar-brace placeholders come from .local/env
# plus the paths computed by the stack manager (LOCAL_DIR, SYNAPSE_DIR).
# Do not use this config in production: rate limits are effectively disabled.

server_name: "${MATRIX_SERVER_NAME}"
pid_file: "${SYNAPSE_DIR}/homeserver.pid"
public_baseurl: "${AGENTSTUDIO_SERVER_URL}/"
report_stats: false
suppress_key_server_warning: true

listeners:
  - port: ${SYNAPSE_PORT}
    bind_addresses: ["127.0.0.1"]
    type: http
    tls: false
    x_forwarded: true
    resources:
      - names: [client]
        compress: false

database:
  name: psycopg2
  args:
    user: agentstudio
    dbname: synapse
    host: 127.0.0.1
    port: ${PG_PORT}
    cp_min: 2
    cp_max: 10

media_store_path: "${SYNAPSE_DIR}/media_store"
signing_key_path: "${SYNAPSE_DIR}/signing.key"
url_preview_enabled: false

# Federation is off.
federation_domain_whitelist: []
trusted_key_servers: []
allow_public_rooms_over_federation: false

# Accounts are created only by JWT login (agentstudio-api) and appservices.
enable_registration: false
registration_shared_secret: "${SYNAPSE_REGISTRATION_SECRET}"
macaroon_secret_key: "${SYNAPSE_MACAROON_SECRET}"
form_secret: "${SYNAPSE_FORM_SECRET}"
password_config:
  enabled: false

jwt_config:
  enabled: true
  secret: "${SYNAPSE_JWT_SECRET}"
  algorithm: HS256
  subject_claim: sub

app_service_config_files:
  - "${SYNAPSE_DIR}/registration-demo.yaml"
  - "${SYNAPSE_DIR}/registration-agents.yaml"

# Very relaxed rate limits for local development and e2e.
rc_message: { per_second: 1000, burst_count: 1000 }
rc_registration: { per_second: 1000, burst_count: 1000 }
rc_registration_token_validity: { per_second: 1000, burst_count: 1000 }
rc_login:
  address: { per_second: 1000, burst_count: 1000 }
  account: { per_second: 1000, burst_count: 1000 }
  failed_attempts: { per_second: 1000, burst_count: 1000 }
rc_admin_redaction: { per_second: 1000, burst_count: 1000 }
rc_joins:
  local: { per_second: 1000, burst_count: 1000 }
  remote: { per_second: 1000, burst_count: 1000 }
rc_joins_per_room: { per_second: 1000, burst_count: 1000 }
rc_3pid_validation: { per_second: 1000, burst_count: 1000 }
rc_invites:
  per_room: { per_second: 1000, burst_count: 1000 }
  per_user: { per_second: 1000, burst_count: 1000 }
  per_issuer: { per_second: 1000, burst_count: 1000 }
rc_third_party_invite: { per_second: 1000, burst_count: 1000 }
rc_media_create: { per_second: 1000, burst_count: 1000 }
rc_room_creation: { per_second: 1000, burst_count: 1000 }
rc_reports: { per_second: 1000, burst_count: 1000 }
rc_delayed_event_mgmt: { per_second: 1000, burst_count: 1000 }
rc_presence:
  per_user: { per_second: 1000, burst_count: 1000 }
rc_federation:
  window_size: 1000
  sleep_limit: 1000
  sleep_delay: 0
  reject_limit: 1000
  concurrent: 100
