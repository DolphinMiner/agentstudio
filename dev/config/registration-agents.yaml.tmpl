# Appservice registration for agentstudio-bridge-agents. Rendered by dev/stack.mjs into
# .local/synapse/registration-agents.yaml and loaded by Synapse (app_service_config_files).
# Must match .local/bridges/agents.yaml (appservice.id, tokens, bot username, username_template).
id: agents
url: "${AGENTS_BRIDGE_URL}"
as_token: "${AGENTS_AS_TOKEN}"
hs_token: "${AGENTS_HS_TOKEN}"
sender_localpart: agentsbot
rate_limited: false
receive_ephemeral: true
de.sorunome.msc2409.push_ephemeral: true
namespaces:
  users:
    - regex: '^@agentsbot:agentstudio\.local$'
      exclusive: true
    - regex: '^@agents_.*:agentstudio\.local$'
      exclusive: true
